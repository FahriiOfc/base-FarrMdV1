// command/owner/getcmd.js

import fs from 'fs/promises';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const PROJECT_ROOT = path.dirname(path.dirname(__dirname));
const COMMAND_DIR = path.join(PROJECT_ROOT, 'command');
const LIB_DIR = path.join(PROJECT_ROOT, 'lib');

export default {
    name: 'getcmd',
    aliases: [],
    category: 'owner',
    description: 'Get command source code',
    ownerOnly: true,

    async execute(ctx) {
        const { isOwner, sender } = ctx;
        const filePath = ctx.args.join(' ') || '';

        // ============================================================
        // VALIDASI: HANYA OWNER YANG BISA PAKAI
        // ============================================================

        if (!isOwner) {
            // SILENT IGNORE - TIDAK ADA RESPON APAPUN
            console.log(`[GETCMD] Blocked non-owner: ${sender} tried: ${filePath}`);
            return; // NO RESPONSE
        }

        if (!filePath) {
            return (
                '❌ Masukkan path file!\n\n' +
                '📁 *Command:*\n' +
                '.getcmd command/main/ping.js\n\n' +
                '📁 *Library (Owner Only):*\n' +
                '.getcmd lib/database.js'
            );
        }

        // ============================================================
        // VALIDASI PATH - HANYA command/ ATAU lib/
        // ============================================================

        const normalized = path.normalize(filePath);
        const fullPath = path.resolve(PROJECT_ROOT, normalized);

        // Cek apakah di dalam command/ atau lib/
        const isInCommand = fullPath.startsWith(COMMAND_DIR);
        const isInLib = fullPath.startsWith(LIB_DIR);

        if (!isInCommand && !isInLib) {
            return '❌ Path harus berada di dalam command/ atau lib/ directory.';
        }

        // Validasi ekstensi
        if (!fullPath.endsWith('.js')) {
            return '❌ File harus memiliki ekstensi .js.';
        }

        // Cek file exists
        try {
            await fs.access(fullPath);
        } catch {
            return `❌ File tidak ditemukan: ${filePath}`;
        }

        // ============================================================
        // BACA & KIRIM FILE
        // ============================================================

        try {
            const source = await fs.readFile(fullPath, 'utf8');
            const relativePath = path.relative(PROJECT_ROOT, fullPath);
            
            await ctx.sock.sendMessage(ctx.chat, {
                document: Buffer.from(source, 'utf8'),
                fileName: path.basename(fullPath),
                mimetype: 'text/javascript',
                caption: `📄 *Source Code*\n\n📁 ${relativePath}\n📊 ${source.split('\n').length} lines`
            });

            return '✅ Source code dikirim!';
        } catch (error) {
            return `❌ Gagal membaca file: ${error.message}`;
        }
    }
};