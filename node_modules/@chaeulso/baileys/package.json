{
  "name": "@chaeulso/baileys",
  "version": "7.3.3",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./WAProto": "./WAProto/index.js",
    "./WAProto/*": "./WAProto/*",
    "./*": "./*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test test/",
    "test:tdd": "node --test --watch test/",
    "prepack": "npm run build",
    "format": "prettier --write \"{lib,test,scripts}/**/*.{js,ts,mjs,json,md}\""
  },
  "description": "Production-ready WhatsApp Web library. Dual ESM/CJS build with full TypeScript types, hardening, tests and docs. Fork of Baileys (WhiskeySockets).",
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.3",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "protobufjs-cli": "^1.3.3",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "whatsapp-web",
    "multi-device",
    "automation",
    "ws",
    "typescript"
  ],
  "homepage": "https://github.com/chaeulso/baileys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaeulso/baileys.git"
  },
  "bugs": {
    "url": "https://github.com/chaeulso/baileys/issues"
  },
  "license": "MIT",
  "author": {
    "name": "chaeul.so"
  },
  "contributors": [
    {
      "name": "Rajeh Taher (WhiskeySockets/Baileys)"
    }
  ],
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "WAProto",
    "docs",
    "README.md",
    "MIGRATION.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRODUCTION.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/image": "^1.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
