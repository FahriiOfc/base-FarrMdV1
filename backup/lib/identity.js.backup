// lib/identity.js
// Identity Resolution System

import config from '../config.js';

export class IdentityResolver {
    #ownerNumber = null;
    #botJid = null;

    constructor() {
        this.#ownerNumber = this.#normalizeNumber(config.ownerNumber || '');
        console.log('[IDENTITY] Owner Number:', this.#ownerNumber);
    }

    // ============================================================
    // SET BOT JID
    // ============================================================

    setBotJid(botJid) {
        this.#botJid = this.normalizeJid(botJid);
        console.log('[IDENTITY] Bot JID set:', this.#botJid);
    }

    getBotJid() {
        return this.#botJid;
    }

    // ============================================================
    // NORMALIZATION - PUBLIC
    // ============================================================

    normalizeJid(jid) {
        if (!jid) return '';
        return String(jid)
            .trim()
            .replace(/:\d+(?=@)/, '');
    }

    // ============================================================
    // NORMALIZATION - PRIVATE
    // ============================================================

    #normalizeNumber(number) {
        if (!number) return '';
        return String(number)
            .replace(/\D/g, '')
            .replace(/^0+/, '');
    }

    #extractNumber(jid) {
        const normalized = this.normalizeJid(jid);
        if (!normalized) return '';
        const parts = normalized.split('@');
        return this.#normalizeNumber(parts[0]);
    }

    #getJidType(jid) {
        const normalized = this.normalizeJid(jid);
        if (!normalized) return 'unknown';
        if (normalized.endsWith('@lid')) return 'lid';
        if (normalized.endsWith('@s.whatsapp.net')) return 'pn';
        if (normalized.endsWith('@g.us')) return 'group';
        return 'unknown';
    }

    // ============================================================
    // RESOLUTION
    // ============================================================

    async resolve(jid, sock) {
        const normalized = this.normalizeJid(jid);
        if (!normalized) {
            return { 
                jid: '', 
                isOwner: false, 
                isBot: false,
                type: 'unknown',
                number: '',
                isResolved: false,
                pn: null,
                lid: null
            };
        }

        // LOG UNTUK DEBUG
        console.log('[IDENTITY] Resolving JID:', normalized);
        console.log('[IDENTITY] Bot JID:', this.#botJid);
        console.log('[IDENTITY] Owner Number:', this.#ownerNumber);

        const type = this.#getJidType(normalized);
        const number = this.#extractNumber(normalized);
        
        // CEK: Apakah ini BOT JID?
        const isBot = normalized === this.#botJid || number === this.#extractNumber(this.#botJid);
        
        // CEK: Apakah ini OWNER? (Owner = nomor owner ATAU bot sendiri)
        const isOwner = number === this.#ownerNumber || isBot;

        console.log('[IDENTITY] Type:', type);
        console.log('[IDENTITY] Number:', number);
        console.log('[IDENTITY] isBot:', isBot);
        console.log('[IDENTITY] isOwner:', isOwner);

        let resolved = {
            jid: normalized,
            type,
            number,
            isOwner,
            isBot,
            isResolved: false,
            pn: null,
            lid: null
        };

        // Jika ini adalah PN, coba cari LID-nya
        if (type === 'pn' && sock) {
            try {
                const lid = await this.#pnToLid(normalized, sock);
                if (lid) {
                    resolved.lid = lid;
                    resolved.isResolved = true;
                    const lidNumber = this.#extractNumber(lid);
                    if (lidNumber === this.#ownerNumber || lid === this.#botJid) {
                        resolved.isOwner = true;
                    }
                    console.log('[IDENTITY] PN → LID:', lid);
                }
            } catch (e) {
                console.log('[IDENTITY] PN→LID error:', e.message);
            }
        }

        // Jika ini adalah LID, coba cari PN-nya
        if (type === 'lid' && sock) {
            try {
                const pn = await this.#lidToPn(normalized, sock);
                if (pn) {
                    resolved.pn = pn;
                    resolved.isResolved = true;
                    const pnNumber = this.#extractNumber(pn);
                    if (pnNumber === this.#ownerNumber || pn === this.#botJid) {
                        resolved.isOwner = true;
                    }
                    console.log('[IDENTITY] LID → PN:', pn);
                }
            } catch (e) {
                console.log('[IDENTITY] LID→PN error:', e.message);
            }
        }

        console.log('[IDENTITY] Final isOwner:', resolved.isOwner);
        return resolved;
    }

    async resolveFromMessage(message, sock) {
        const sender = this.#getSender(message);
        return this.resolve(sender, sock);
    }

    // ============================================================
    // SENDER EXTRACTION
    // ============================================================

    #getSender(message) {
        if (!message) return '';
        const key = message.key || {};
        let sender = '';

        if (key.remoteJid && key.remoteJid.endsWith('@g.us')) {
            sender = key.participantAlt || key.participant || '';
        } else {
            sender = key.remoteJidAlt || key.remoteJid || '';
        }

        return this.normalizeJid(sender);
    }

    // ============================================================
    // PN ↔ LID MAPPING (via Baileys)
    // ============================================================

    async #lidToPn(lid, sock) {
        try {
            const mapping = sock?.signalRepository?.lidMapping;
            if (mapping && typeof mapping.getPNForLID === 'function') {
                const pn = await mapping.getPNForLID(lid);
                return this.normalizeJid(pn);
            }
        } catch (e) {
            console.log('[IDENTITY] lidToPn error:', e.message);
        }
        return null;
    }

    async #pnToLid(pn, sock) {
        try {
            const mapping = sock?.signalRepository?.lidMapping;
            if (mapping && typeof mapping.getLIDForPN === 'function') {
                const lid = await mapping.getLIDForPN(pn);
                return this.normalizeJid(lid);
            }
        } catch (e) {
            console.log('[IDENTITY] pnToLid error:', e.message);
        }
        return null;
    }

    // ============================================================
    // PARTICIPANT RESOLUTION (untuk grup)
    // ============================================================

    findParticipant(metadata, jid) {
        if (!metadata || !Array.isArray(metadata.participants)) {
            return null;
        }

        const target = this.normalizeJid(jid);
        if (!target) return null;

        // Direct match
        const direct = metadata.participants.find(p => {
            const candidates = [
                p?.id, p?.jid, p?.lid, p?.phoneNumber
            ].map(v => this.normalizeJid(v)).filter(Boolean);
            return candidates.includes(target);
        });

        if (direct) return direct;

        // Number match
        const targetNumber = this.#extractNumber(target);
        if (!targetNumber) return null;

        const byNumber = metadata.participants.find(p => {
            const candidates = [
                p?.phoneNumber, p?.id, p?.jid, p?.lid
            ];
            return candidates.some(v => this.#extractNumber(v) === targetNumber);
        });

        return byNumber || null;
    }

    isAdmin(metadata, jid) {
        const participant = this.findParticipant(metadata, jid);
        if (!participant) return false;
        return participant.admin === 'admin' || participant.admin === 'superadmin';
    }

    // ============================================================
    // OWNER CHECK (SHORTCUT)
    // ============================================================

    async isOwner(jid, sock) {
        const resolved = await this.resolve(jid, sock);
        return resolved.isOwner;
    }

    getOwnerNumber() {
        return this.#ownerNumber;
    }
}

export default new IdentityResolver();